# SCENARIO 21: SUPERMARKET BILLING SYSTEM
# ==========================================================

# Question:
# A supermarket gives a 15% discount if the bill exceeds ₹5000.
# Calculate the final bill.

print("===== SUPERMARKET BILLING SYSTEM =====")

customer = input("Enter Customer Name: ")
bill = float(input("Enter Total Purchase Amount: "))

if bill > 5000:
    discount = bill * 15 / 100
else:
    discount = 0

final_bill = bill - discount

print("Customer Name :", customer)
print("Discount :", discount)
print("Final Bill :", final_bill)


# ==========================================================
# SCENARIO 22: CAR PARKING FEE CALCULATOR
# ==========================================================

# Question:
# Parking charges:
# First 2 Hours = ₹50/hour
# Remaining Hours = ₹30/hour

print("\n===== CAR PARKING FEE =====")

hours = int(input("Enter Parking Hours: "))

if hours <= 2:
    fee = hours * 50
else:
    fee = (2 * 50) + ((hours - 2) * 30)

print("Parking Fee =", fee)


