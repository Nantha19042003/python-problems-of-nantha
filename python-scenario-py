# ==========================================================
# SCENARIO 4: LIBRARY FINE CALCULATOR
# ==========================================================

# Question:
# Calculate library fine.
#
# First 5 days  -> ₹2/day
# Next 5 days   -> ₹5/day
# Above 10 days -> ₹10/day

print("===== LIBRARY FINE CALCULATOR =====")

days = int(input("Enter Delayed Days: "))

if days <= 5:
    fine = days * 2

elif days <= 10:
    fine = (5 * 2) + ((days - 5) * 5)

else:
    fine = (5 * 2) + (5 * 5) + ((days - 10) * 10)

print("Fine Amount =", fine)

print("\n")


# ==========================================================
# SCENARIO 5: EMPLOYEE SALARY CALCULATOR
# ==========================================================

# Question:
# Calculate Gross Salary.
#
# HRA = 20%
# DA = 10%

print("===== EMPLOYEE SALARY =====")

employee = input("Employee Name: ")
basic = float(input("Basic Salary: "))

hra = basic * 20 / 100
da = basic * 10 / 100

gross = basic + hra + da

print("\nEmployee Name :", employee)
print("Basic Salary  :", basic)
print("HRA           :", hra)
print("DA            :", da)
print("Gross Salary  :", gross)

print("\n")


# ==========================================================
# SCENARIO 6: RESTAURANT BILLING SYSTEM
# ==========================================================

# Question:
# Calculate restaurant bill including GST (5%).

print("===== RESTAURANT BILL =====")

food = input("Food Item: ")

price = float(input("Price: "))

qty = int(input("Quantity: "))

total = price * qty

gst = total * 5 / 100

bill = total + gst

print("\nFood Item :", food)
print("Total     :", total)
print("GST       :", gst)
print("Final Bill:", bill)

print("\n")


# ==========================================================
# SCENARIO 7: ELECTRICITY BILL SYSTEM
# ==========================================================

# Question:
#
# First 100 Units = ₹2/unit
# Next 100 Units = ₹3/unit
# Above 200 Units = ₹5/unit

print("===== ELECTRICITY BILL =====")

units = int(input("Enter Units: "))

if units <= 100:

    bill = units * 2

elif units <= 200:

    bill = (100 * 2) + ((units - 100) * 3)

else:

    bill = (100 * 2) + (100 * 3) + ((units - 200) * 5)

print("Electricity Bill =", bill)

print("\n")


