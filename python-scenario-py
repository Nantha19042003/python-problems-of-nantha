amount = float(input("Purchase Amount: "))

if amount > 5000:

    discount = amount * 20 / 100

elif amount > 3000:

    discount = amount * 10 / 100

else:

    discount = 0

final = amount - discount

print("Discount :", discount)
print("Final Amount :", final)

print("\n")


